{
  "name": "ddex-engine",
  "version": "0.1.0",
  "description": "Private DDEX ERN 4.3 builder and parser for music distribution infrastructure",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "ddex": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "libxmljs2"
    ]
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "ddex": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:conformance": "vitest run --config vitest.conformance.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "citty": "^0.1.6",
    "fast-xml-parser": "^4.5.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "libxmljs2": "^0.37.0",
    "tsup": "^8.2.4",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
